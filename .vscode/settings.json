{
    "swift.path": "/Applications/Xcode-27.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin",
    "swift.swiftEnvironmentVariables": {
        "DEVELOPER_DIR": "/Applications/Xcode-27.app/Contents/Developer"
    },
    "terminal.integrated.env.osx": {
        "DEVELOPER_DIR": "/Applications/Xcode-27.app/Contents/Developer"
    },
    "swift.sourcekit-lsp.serverArguments": ["--default-workspace-type", "buildServer"],
    "[swift]": {
        "editor.defaultFormatter": "swiftlang.swift-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "files.watcherExclude": {
        "**/.build/**": true
    },
    "search.exclude": {
        "**/.build": true
    }
}
