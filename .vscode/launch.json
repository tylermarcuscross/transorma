{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Transorma: isolated UI",
            "type": "swift",
            "request": "launch",
            "program": "${workspaceFolder}/.build/Xcode/Build/Products/Development/Transorma.app/Contents/MacOS/Transorma",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Transorma: build"
        },
        {
            "name": "Transorma: network diagnostics",
            "type": "swift",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/transorma-diagnostics",
            "args": [
                "--network"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Transorma: build diagnostics"
        },
        {
            "name": "Transorma: intelligence diagnostics",
            "type": "swift",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/transorma-diagnostics",
            "args": [
                "--intelligence"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Transorma: build diagnostics"
        }
    ]
}
